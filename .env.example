# ── Supabase ─────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard.
# The anon key is safe to expose to the browser (it's rate-limited by RLS
# policies), which is why it's prefixed with VITE_ so Vite inlines it into
# the client bundle. NEVER put the service_role key behind a VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed if you add server-side/admin Supabase operations later
# (migrations, seeding scripts, privileged edge functions). Keep this out
# of the client bundle — it bypasses Row Level Security entirely.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Gemini AI (existing /api/ai/lookup proxy) ───────────────────────────
GEMINI_API_KEY=your-gemini-api-key
